# CLARIO Environment Configuration
# Copy this file to .env and fill in the keys for the providers you select.

# AI Provider Settings
AI_PROVIDER=mock
# Optional override; defaults depend on the selected provider.
AI_MODEL=

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Mistral (https://console.mistral.ai/api-keys/)
MISTRAL_API_KEY=

# Web research (https://app.tavily.com/home; backend only)
TAVILY_API_KEY=

# Adaptive learning: maximum reteach/retest executions per session and concept (default: 3)
CLARIO_MAX_REMEDIATION_ATTEMPTS=3

# Database
# Local development/test default. In production set DATABASE_URL to the
# Neon PostgreSQL connection string in the deployment settings.
DATABASE_URL=sqlite:///./clario.db

# Online backend deployment settings
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173